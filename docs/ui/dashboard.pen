                      "clip": true,
                      "width": "fill_container",
                      "height": "fill_container",
                      "fill": "#0b1120",
                      "cornerRadius": 12,
                      "stroke": {
                        "align": "inside",
                        "thickness": 1,
                        "fill": "#22324a"
                      },
                      "layout": "vertical",
                      "gap": 6,
                      "padding": 20,
                      "children": [
                        {
                          "type": "text",
                          "id": "Khiux",
                          "name": "mdLine1",
                          "fill": "#f5f9ff",
                          "content": "# Design: Registro de Gastos",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "cCUk3",
                          "name": "mdLine2",
                          "fill": "#f5f9ff",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "4VUEW",
                          "name": "mdLine3",
                          "fill": "#f5f9ff",
                          "content": "This document outlines the design decisions for the expense",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "rUv28",
                          "name": "mdLine4",
                          "fill": "#f5f9ff",
                          "content": "registration feature, including the data model, API contracts,",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "3VV3e",
                          "name": "mdLine5",
                          "fill": "#f5f9ff",
                          "content": "and user interface flow.",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "gKfrP",
                          "name": "mdLine6",
                          "fill": "#f5f9ff",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "yF3ax",
                          "name": "mdLine7",
                          "fill": "#f5f9ff",
                          "content": "## Technical Approach",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "xe6S5",
                          "name": "mdLine8",
                          "fill": "#f5f9ff",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "PG9fv",
                          "name": "mdLine9",
                          "fill": "#f5f9ff",
                          "content": "The feature follows a vertical slice architecture with a",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "EYc2B",
                          "name": "mdLine10",
                          "fill": "#f5f9ff",
                          "content": "dedicated domain module. Each expense record is immutable",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "OgnUw",
                          "name": "mdLine11",
                          "fill": "#f5f9ff",
                          "content": "once approved, with soft-delete support for audit compliance.",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "z8PQj",
                          "name": "mdLine12",
                          "fill": "#f5f9ff",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Fjpjo",
                          "name": "mdLine13",
                          "fill": "#f5f9ff",
                          "content": "## Data Model",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Usu1b",
                          "name": "mdLine14",
                          "fill": "#f5f9ff",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "OyN1v",
                          "name": "mdLine15",
                          "fill": "#f5f9ff",
                          "content": "| Field       | Type          | Description          |",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "llxuQ",
                          "name": "mdLine16",
                          "fill": "#525e6e",
                          "content": "|-------------|---------------|----------------------|",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
